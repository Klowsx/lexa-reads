# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=


# Google Books API — obtener en console.cloud.google.com > APIs > Books API > Credenciales
# Opcional para desarrollo (sin key: 1,000 req/día por IP). Requerido para producción.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# NYT — YA NO va en el cliente (NEW-4). La key es ahora un secret del servidor,
# usado por la Edge Function `nyt-bestsellers`. Configúralo con:
#   supabase secrets set NYT_API_KEY=<tu_key>
# (No definas EXPO_PUBLIC_NYT_API_KEY: se empaquetaría en el bundle y es extraíble.)