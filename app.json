{
  "expo": {
    "name": "lexa",
    "slug": "lexa",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "lexa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexareads.app",
      "associatedDomains": ["applinks:lexareads.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lexareads.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "lexareads.app", "pathPrefix": "/book" },
            { "scheme": "https", "host": "lexareads.app", "pathPrefix": "/user" },
            { "scheme": "https", "host": "lexareads.app", "pathPrefix": "/list" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "837bca0d-13c4-4553-b886-a21d10a05aa6"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C4783A",
          "sounds": []
        }
      ]
    ],
    "owner": "javierhr"
  }
}
