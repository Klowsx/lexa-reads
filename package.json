    "@types/node": "^25.9.1",
    "@types/react": "~19.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.99.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "pnpm": {
    "overrides": {
      "@expo/metro-runtime": "~6.1.2",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1"
    }
