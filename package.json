{
  "name": "lexa",
  "experiments": {
    "typedRoutes": true
  },
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev": "expo start",
    "web": "expo start --web",
    "prestart": "pnpm gen:theme",
    "preandroid": "pnpm gen:theme",
    "preios": "pnpm gen:theme",
    "preweb": "pnpm gen:theme",
    "format": "prettier --write .",
    "format:auth": "prettier --write \"app/(auth)\" src/features/auth",
    "format:auth:check": "prettier --check \"app/(auth)\" src/features/auth",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "lint:auth": "eslint \"app/(auth)/**/*.{ts,tsx}\" \"src/features/auth/**/*.{ts,tsx}\"",
    "lint:auth:fix": "pnpm lint:auth --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "check:theme": "node scripts/generate-theme-tokens.mjs --check",
    "legal:render": "node scripts/render-legal-docs.mjs",
    "gen:theme": "node scripts/generate-theme-tokens.mjs",
    "gen:types": "supabase gen types typescript --project-id nvgygpsuqltjfexsjwoq > src/types/database.ts"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
